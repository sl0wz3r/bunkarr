# The restic and rclone versions the Bunkarr image ships and the engine tests measured
# (docs/design/phase4.md §20.3), as upstream versions: alpine packages, any -rN rebuild of them.
# The Dockerfile and docker/engines/Dockerfile install exactly these (apk "restic~X.Y.Z"), so an
# image build fails rather than ship another version untested, and docker/test-image.sh (CI and
# the release's candidate on amd64 and arm64) checks what /system/status reports. To move to a
# new version: change it here, then run make test-engines and make test-offsite.
# Sourced by sh: plain NAME=value lines only.
RESTIC_VERSION=0.18.1
RCLONE_VERSION=1.74.1
