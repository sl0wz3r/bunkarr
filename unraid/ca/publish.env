# Bunkarr: public Community Applications settings. THE ONE PLACE for the public owner, repository
# and registry. Every public URL in unraid/bunkarr.xml and ca_profile.xml is derived from here.
#
# After editing:  make ca-template ca-profile   (then commit unraid/bunkarr.xml and ca_profile.xml)
# Show values:    make ca-vars
# Format:         KEY=value, one per line, no inline comments. Parsed by unraid/ca/render.sh,
#                 never sourced. An empty value means "use the default" shown in the comment.
#
# Never rename or transfer the repository, or rename the account, once the app is listed in
# Community Applications: CA can blacklist the whole repository for it. Never move
# unraid/bunkarr.xml either: installed containers keep reading their TemplateURL.

# GitHub account that owns the public repository (spelled as on GitHub).
PUBLIC_OWNER=sl0wz3r

# Public source repository (code, issues, image package, unraid/icon.png, unraid/README.md).
PUBLIC_REPO=bunkarr

# Default: github.com. The CA submission form only accepts GitHub repositories.
PUBLIC_HOST=github.com

# Default: main. CA reads templates from the default branch.
PUBLIC_BRANCH=main

# A separate templates repository (layout B) is not used: the template lives in this repository,
# at the default TEMPLATE_PATH unraid/bunkarr.xml.
TEMPLATES_REPO=
TEMPLATE_PATH=

# The image is REGISTRY/<lower-case owner>/IMAGE_NAME:IMAGE_TAG = ghcr.io/sl0wz3r/bunkarr:latest.
# It must match the image .github/workflows/release.yml pushes (its "Image name" step) and the
# image in deploy/docker-compose.yml (deploy/unraid_test.go). Keep IMAGE_TAG=latest: Unraid's
# update check follows that tag; release.yml moves it only for vX.Y.Z (never a pre-release).
REGISTRY=ghcr.io
IMAGE_NAME=bunkarr
IMAGE_TAG=latest

# <Icon> in the template and the profile. Empty = the raw URL of unraid/icon.png on PUBLIC_BRANCH
# (make ca-vars prints it). Unraid and CA cache icons by URL: when the icon changes after the
# listing (make ca-icon), set that URL here with ?v=2 appended (then ?v=3, ...).
ICON_URL=

# Support link in the template. Empty = GitHub Issues of PUBLIC_REPO (accepted by CA). Once the
# "[Support] sl0wz3r - Bunkarr" forum thread exists, put its URL here AND in FORUM_URL.
SUPPORT_URL=

# ca_profile.xml <Forum>. Empty = the element is left out.
FORUM_URL=

# The newest release and its date: <Date> in the template (CA's "Updated Apps" list). The
# changelog text lives in unraid/ca/bunkarr.xml.tmpl (<Changes>), whose newest entry must name
# this version and date, like the newest release in CHANGELOG.md (deploy/unraid_changes_test.go).
# Until v0.1.0 is tagged, RELEASE_DATE is the planned date: the release commit sets the real one
# here and in <Changes>.
VERSION=0.1.0
RELEASE_DATE=2026-10-01
