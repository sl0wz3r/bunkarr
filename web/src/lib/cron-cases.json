    },
    {
      "expr": "0 0 , * *",
      "valid": false,
      "why": "an empty day of month with a star weekday: both must match"
    },
    {
      "expr": "0 0 * * ,",
      "valid": false,
      "why": "an empty weekday with a star day of month: both must match"
    },
    {
      "expr": "0 0 , * ,",
      "valid": false,
      "why": "both day fields empty"
    },
    {
      "expr": "0 0 ,,5 * ,",
      "valid": true,
      "why": "empty items of a list are skipped"
    }
  ]
}
